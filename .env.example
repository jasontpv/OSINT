# OSINT Kanban Pipeline - Environment Configuration
# Copy this file to .env and fill in your actual API keys

# Serper.dev Search API (Google, Bing, DuckDuckGo)
SERPER_API_KEY=your_serper_api_key_here

# Scrapingant Web Scraper API (for HTML content extraction)
SCRAPINGANT_API_KEY=your_scrapingant_api_key_here

# Optional: Social Media APIs (Twitter/X, LinkedIn, etc.)
TWITTER_API_KEY=optional_twitter_key
LINKEDIN_API_KEY=optional_linkedin_key
GITHUB_TOKEN=optional_github_token

# Pipeline Configuration
MAX_RETRIES_PER_TICKET=3
WIP_LIMITS={"RECON": 3, "HARVESTING": 5, "ANALYST": 2, "SCRIBE": 1}
LOG_LEVEL=INFO
