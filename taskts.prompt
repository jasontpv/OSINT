LLM helper

Copy
python
def get_llm_client(self):
    if self.privacy_mode == "private" or os.getenv("USE_CLOUD_LLM") == "1":
        # Return cloud client (e.g., OpenAI)
        return lambda prompt: openai.ChatCompletion.create(
            model="gpt-4",
            messages=[{"role": "user", "content": prompt}]
        ).choices[0].message.content
    else:
        # Return local Ollama client
        return lambda prompt: ollama.Completion(prompt=prompt, model="llama3.2")
