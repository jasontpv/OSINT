"""
OSINT Harvesting Stage - Collects data from multiple OSINT tools and stores in database.
Implements a pipeline that harvests data for each target and persists it immediately.
"""

import os
import sys
import json
import logging
from typing import Dict, List, Optional, Any
from datetime import datetime
import subprocess
from pathlib import Path

# Add parent directory to path to import from the project root
sys.path.insert(0, str(Path(__file__).parent.parent))

from database_manager import get_db_manager

# Configure logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)


class OSINTHarvester:
    """Main class for harvesting data using various OSINT tools."""
    
    def __init__(self, db_manager=None):
        """Initialize the harvester with optional database manager.
        
        Args:
            db_manager: DatabaseManager instance (optional, will create one if not provided)
        """
        self.db_manager = db_manager or get_db_manager()
        self.results_summary = {
            "total_tools_run": 0,
            "successful_runs": 0,
            "failed_runs": 0,
            "tools_failed": []
        }
    
    def run_tool(self, tool_name: str, target: str, ticket_id: str) -> Optional[str]:
        """Run a single OSINT tool and store result in database.
        
        Args:
            tool_name: Name of the tool to run (e.g., 'shodan', 'hunter', 'securitytrails')
            target: Target domain/IP to scan
            ticket_id: The current recon/ticket identifier
            
        Returns:
            Raw output string if successful, None otherwise.
        """
        # Get tool configuration from osint_cli_wrapper.py
        try:
            from osint_cli_wrapper import OSINTCLIWrapper
            wrapper = OSINTCLIWrapper()
            config = wrapper.get_tool_config(tool_name)
            
            if not config or 'command_template' not in config:
                logger.warning(f"Tool {tool_name} not found or no command template configured")
                return None
            
            command = config['command_template'].format(target=target)
            
            # Run the tool
            logger.info(f"Running {tool_name} on target: {target}")
            process = subprocess.run(
                command, 
                shell=True, 
                capture_output=True, 
                text=True, 
                timeout=300  # 5 minute timeout per tool
            )
            
            self.results_summary["total_tools_run"] += 1
            
            if process.returncode == 0:
                self.results_summary["successful_runs"] += 1
                raw_output = process.stdout.strip() or process.stderr.strip()
                
                # Store result in database immediately
                if self.db_manager.insert_raw_harvest(ticket_id, tool_name, raw_output):
                    logger.info(f"Successfully harvested {tool_name} data for ticket {ticket_id}")
                    return raw_output
                else:
                    logger.error(f"Failed to store {tool_name} data in database")
                    return None
            else:
                self.results_summary["failed_runs"] += 1
                error_msg = f"{tool_name} failed with code {process.returncode}: {process.stderr}"
                logger.warning(error_msg)
                
                # Store the error output anyway for debugging
                self.db_manager.insert_raw_harvest(ticket_id, tool_name, f"ERROR: {error_msg}")
                self.results_summary["tools_failed"].append(tool_name)
                return None
                
        except subprocess.TimeoutExpired:
            logger.error(f"{tool_name} timed out after 5 minutes")
            self.results_summary["failed_runs"] += 1
            self.results_summary["tools_failed"].append(f"{tool_name}_timeout")
            return None
        except Exception as e:
            logger.error(f"Error running {tool_name}: {e}")
            self.results_summary["failed_runs"] += 1
            self.results_summary["tools_failed"].append(str(e))
            return None
    
    def harvest_all(self, target: str, ticket_id: str) -> Dict[str, Any]:
        """Run all configured OSINT tools for a given target.
        
        Args:
            target: Target domain/IP to scan
            ticket_id: The current recon/ticket identifier
            
        Returns:
            Dictionary containing harvest results and summary statistics
        """
        logger.info(f"Starting full OSINT harvest for target: {target} (ticket: {ticket_id})")
        
        # List of tools to run (order matters - faster tools first)
        tool_list = [
            'shodan',      # Fast API-based lookup
            'hunter',      # Fast API-based lookup
            'securitytrails'  # Fast API-based lookup
        ]
        
        results = {
            "target": target,
            "ticket_id": ticket_id,
            "timestamp": datetime.now().isoformat(),
            "tools_run": [],
            "raw_data_sources": []
        }
        
        for tool_name in tool_list:
            output = self.run_tool(tool_name, target, ticket_id)
            
            if output is not None:
                results["tools_run"].append(tool_name)
                results["raw_data_sources"].append({
                    "tool": tool_name,
                    "status": "success",
                    "content_length": len(output),
                    "stored_in_db": True
                })
            else:
                results["tools_run"].append(f"{tool_name}_failed")
                logger.warning(f"Tool {tool_name} did not produce output for target {target}")
        
        # Store summary statistics in database as well
        self.db_manager.insert_raw_harvest(
            ticket_id, 
            "harvest_summary", 
            json.dumps({
                **self.results_summary,
                "timestamp": datetime.now().isoformat()
            })
        )
        
        logger.info(f"Harvest complete for {target}: {self.results_summary['successful_runs']}/{len(tool_list)} tools successful")
        return results
    
    def get_harvested_data_for_ticket(self, ticket_id: str) -> List[Dict[str, Any]]:
        """Get all raw harvested data for a specific ticket.
        
        Args:
            ticket_id: The ticket identifier
            
        Returns:
            List of dictionaries containing raw harvest data from database
        """
        return self.db_manager.get_raw_harvest(ticket_id)
    
    def get_harvest_summary(self, ticket_id: str) -> Dict[str, Any]:
        """Get summary statistics for a specific ticket's harvest.
        
        Args:
            ticket_id: The ticket identifier
            
        Returns:
            Dictionary containing harvest summary statistics
        """
        raw_data = self.get_harvested_data_for_ticket(ticket_id)
        
        return {
            "ticket_id": ticket_id,
            "total_records": len(raw_data),
            "sources": list(set([record['source'] for record in raw_data])),
            "harvest_timestamps": [record['timestamp'] for record in raw_data],
            **self.results_summary
        }


def run_harvest(target: str, ticket_id: str = None) -> Dict[str, Any]:
    """Convenience function to run OSINT harvesting.
    
    Args:
        target: Target domain/IP to scan
        ticket_id: Optional ticket identifier (auto-generated if not provided)
        
    Returns:
        Dictionary containing harvest results
    """
    if ticket_id is None:
        import uuid
        ticket_id = f"recon_{uuid.uuid4().hex[:6]}"
    
    harvester = OSINTHarvester()
    return harvester.harvest_all(target, ticket_id)


if __name__ == "__main__":
    # Example usage
    if len(sys.argv) > 1:
        target = sys.argv[1]
    else:
        target = "example.com"
    
    print(f"\n{'='*60}")
    print(f"OSINT HARVESTING STAGE")
    print(f"Target: {target}")
    print(f"{'='*60}\n")
    
    result = run_harvest(target)
    
    print("\nHarvest Results:")
    print(json.dumps(result, indent=2))
    
    # Verify data was stored in database
    harvester = OSINTHarvester()
    db_data = harvester.get_harvested_data_for_ticket(result['ticket_id'])
    
    print(f"\n{'='*60}")
    print("DATABASE VERIFICATION")
    print(f"{'='*60}")
    print(f"Records stored in database: {len(db_data)}")
    for record in db_data:
        print(f"  - {record['source']}: {len(record['raw_content'])} bytes")
    
    summary = harvester.get_harvest_summary(result['ticket_id'])
    print(f"\nSummary Statistics:")
    for key, value in summary.items():
        if key not in ['total_records', 'harvest_timestamps']:
            print(f"  {key}: {value}")


